#!/bin/sh
# postinst script for the database backend of abraflexi-webhook-acceptor
#
# The .env.template that dbconfig-common fills in is shipped by this package,
# so the database is created and migrated here (the main package is configured
# before its backend is unpacked and cannot do it).
set -e

. /usr/share/debconf/confmodule

if [ "$1" = "configure" ] && [ -f /usr/share/dbconfig-common/dpkg/postinst ]; then
    . /usr/share/dbconfig-common/dpkg/postinst
    dbc_generate_include_args="-U -o template_infile=/usr/lib/abraflexi-webhook-acceptor/.env.template"
    dbc_generate_include=template:/etc/abraflexi-webhook-acceptor/.env
    dbc_generate_include_owner="root:www-data"
    dbc_generate_include_perms="664"
    dbc_dbfile_owner="www-data:www-data"
    dbc_dbfile_perms="0664"

    dbc_go abraflexi-webhook-acceptor "$@"

    if [ -f /etc/abraflexi-webhook-acceptor/.env ]; then
        phinx migrate -c /usr/lib/abraflexi-webhook-acceptor/phinx-adapter.php
    fi
fi

#DEBHELPER#

exit 0
